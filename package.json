{
  "name": "settlement",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:all": "node scripts/dev-all.mjs",
    "worker": "node --experimental-strip-types worker/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mjs",
    "eval:agent": "node --experimental-strip-types scripts/eval-agent.mjs",
    "test:integration": "node --experimental-strip-types --test tests/http.integration.mjs",
    "smoke": "node scripts/smoke-hosted.mjs",
    "test:e2e": "playwright test",
    "build:package": "npm run build --prefix packages/settlement-testbed",
    "check:package": "npm run check --prefix packages/settlement-testbed",
    "check:versions": "node scripts/check-versions.mjs",
    "version": "node scripts/sync-versions.mjs && git add packages/settlement-testbed/package.json action.yml",
    "docs:package-readme": "node scripts/build-package-readme.mjs",
    "gallery:verify": "node --experimental-strip-types scripts/verify-gallery.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "description": "A multi-agent village strategy game with autonomous residents, inspectable decisions, deterministic replay, and optional Claude research experiments.",
  "license": "MIT",
  "author": "Kaushik Reddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lingikaushikreddy/Settlement-Village.git"
  },
  "homepage": "https://github.com/Lingikaushikreddy/Settlement-Village#readme",
  "bugs": {
    "url": "https://github.com/Lingikaushikreddy/Settlement-Village/issues"
  },
  "keywords": [
    "multi-agent-systems",
    "game-ai",
    "agent-based-modeling",
    "village-simulation",
    "strategy-game",
    "browser-game",
    "typescript",
    "react",
    "pathfinding",
    "deterministic-simulation",
    "explainable-ai",
    "claude"
  ]
}
